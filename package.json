{
  "name": "dsh-context-ledger",
  "version": "0.1.1",
  "description": "Native DSH compaction with a durable, session-scoped engineering evidence archive",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "context", "compaction", "evidence", "sqlite"],
  "engines": { "node": ">=22.16.0", "dsh": "0.2.1-rc.5" },
  "exports": {
    ".": "./src/index.mjs",
    "./compaction": "./src/compaction.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.mjs", "cordis.patch.yml", "examples/*.yml", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE",
    "docs/*.md", "test/*.mjs", "scripts/build-preset-patch.mjs", "scripts/check.mjs",
    "scripts/dsh-host.mjs", "scripts/verify-package.mjs", "scripts/audit-public.mjs"
  ],
  "dependencies": { "js-yaml": "4.3.2" },
  "devDependencies": { "@deepseek-ai/dsh": "0.2.1-rc.5" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "scripts": {
    "test": "node --import ./test/bootstrap.mjs --test test/*.test.mjs",
    "test:archive": "node --test test/archive.test.mjs",
    "check": "node scripts/check.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "publishConfig": { "access": "public" }
}
